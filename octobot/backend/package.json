{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "generate": "prisma generate",
    "test": "tsx --test",
    "lab:fixture": "tsx src/cpm-lab/main.ts fixture"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@prisma/client": "6",
    "bullmq": "^6.3.8",
    "fastify": "^5.12.5",
    "grammy": "^1.46.0",
    "ioredis": "^6.0.0",
    "pg": "8.23.1",
    "teleproto": "1.230.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "8.23.1",
    "prisma": "6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
