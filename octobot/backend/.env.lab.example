# CPM measurement lab. Copy to backend/.env.lab on the server, edit locally,
# then run: chmod 600 backend/.env.lab
# Never paste these values into chat. backend/.env.lab is ignored by Git and Docker builds.
# Compose passes each lab service only the keys it needs. The backend service gets none.
# Avoid "$" in values, because Compose interpolates it.

# Lab database service (lab-postgres). Independent user, password, and volume.
LAB_POSTGRES_USER=cpm_lab
LAB_POSTGRES_PASSWORD=
LAB_POSTGRES_DB=cpm_lab

# Lab connection from the cpm-lab container. Host lab-postgres, never the application postgres.
# Must use the same user, password, and database as above.
# LAB_DATABASE_URL=postgresql://cpm_lab:<password>@lab-postgres:5432/cpm_lab
LAB_DATABASE_URL=

# Separate test database on lab-postgres. lab.sh test-db creates it if missing,
# applies the lab migrations in a temporary schema cpm_lab_test_<hex>, and drops only that schema.
# LAB_TEST_DATABASE_URL=postgresql://cpm_lab:<password>@lab-postgres:5432/cpm_lab_test
LAB_TEST_DATABASE_URL=

# From my.telegram.org with the first lab account's number.
# Each number can currently be associated with one api_id.
LAB_API_ID=
LAB_API_HASH=

# A new test bot from BotFather, not the platform bot. Remove it after login-bot succeeds.
LAB_BOT_TOKEN=

# 64 hex characters, for example from: openssl rand -hex 32
# Must differ from ENCRYPTION_KEY in backend/.env. lab.sh checks this without printing either key.
LAB_SESSION_ENCRYPTION_KEY=

# Test channel: the bot is an administrator and the lab account is a member.
# LAB_CHANNEL_ID accepts the -100 Bot API form or the bare id.
LAB_CHANNEL_ID=
LAB_POST_ID=
# The user session resolves the channel with one of these. It never joins a channel.
LAB_CHANNEL_USERNAME=
LAB_CHANNEL_INVITE_LINK=

# Optional. Defaults: 12 rounds every 300 seconds, so 24 base trial reads.
LAB_TRIAL_ROUNDS=
LAB_TRIAL_INTERVAL_SECONDS=
